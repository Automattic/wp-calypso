# frozen_string_literal: true

require 'fastlane/plugin/wpmreleasetoolkit'
require 'json'

EnvManager = Fastlane::Wpmreleasetoolkit::EnvManager

fastlane_version '2.0'

default_platform :mac

PROJECT_ROOT_FOLDER = File.dirname(File.expand_path(__dir__))

ENV_FILE_NAME = 'wordpress-desktop.env'

TEAM_ID = 'PZYM8XX95Q'

CODE_SIGNING_STORAGE_OPTIONS = {
  storage_mode: 's3',
  s3_bucket: 'a8c-fastlane-match',
  s3_region: 'us-east-2'
}.freeze

# Required for sync_code_signing to authenticate with S3.
CODE_SIGNING_ENV_VARS = %w[
  MATCH_S3_ACCESS_KEY
  MATCH_S3_SECRET_ACCESS_KEY
  MATCH_PASSWORD
].freeze

# Required for app_store_connect_api_key to generate the key information to pass down the call chain.
ASC_API_KEY_ENV_VARS = %w[
  APP_STORE_CONNECT_API_KEY_KEY_ID
  APP_STORE_CONNECT_API_KEY_ISSUER_ID
  APP_STORE_CONNECT_API_KEY_KEY
].freeze

# Selects which mitigation `before_all` applies for the macOS 26 BK
# image's broken signing-chain trust. Defaults to `cert-import` to
# preserve current production behaviour. The diagnostic lane overrides
# it to compare variants.
#
#   none         — no mitigation (control; expected to fail signing)
#   search-list  — append /Library/Keychains/System.keychain to the
#                  user search list after setup_ci (prior approach,
#                  see commit 522d4f37f78)
#   cert-import  — fetch the Developer ID G2 intermediate from Apple
#                  and import it into the temp keychain (current
#                  trunk approach, see commit 6d46be9c135)
KEYCHAIN_FIX_VARIANTS = %w[none search-list cert-import].freeze

before_all do
  # This is necessary for 'match' to work correctly in CI. When running
  # locally, it has no effect so it's safe to run it before all lanes.
  setup_ci

  if FastlaneCore::Helper.is_ci?
    variant = ENV.fetch('KEYCHAIN_FIX', 'cert-import')
    UI.user_error!("Unknown KEYCHAIN_FIX=#{variant}; expected one of #{KEYCHAIN_FIX_VARIANTS.join(', ')}") unless KEYCHAIN_FIX_VARIANTS.include?(variant)

    UI.message("KEYCHAIN_FIX=#{variant}")

    case variant
    when 'none'
      # Intentionally do nothing — control variant for the diagnostic.
    when 'search-list'
      sh(
        'security', 'list-keychains',
        '-d', 'user',
        '-s',
        File.join(Dir.home, 'Library/Keychains/fastlane_tmp_keychain-db'),
        '/Library/Keychains/System.keychain'
      )
    when 'cert-import'
      cert_path = File.join(Dir.tmpdir, 'DeveloperIDG2CA.cer')
      sh(
        'curl',
        '-fsSL',
        'https://www.apple.com/certificateauthority/DeveloperIDG2CA.cer',
        '-o',
        cert_path
      )
      import_certificate(
        certificate_path: cert_path,
        keychain_name: 'fastlane_tmp_keychain'
      )
    end
  end

  EnvManager.set_up(env_file_name: ENV_FILE_NAME)
end

platform :mac do
  desc 'Download and configure code signing certificates and provisioning profiles .'
  lane :configure_code_signing do |readonly: true|
    EnvManager.require_env_vars!(*CODE_SIGNING_ENV_VARS)

    unless readonly
      # We need the API key instantiated only when making changes on ASC (readonly = false)
      EnvManager.require_env_vars!(*ASC_API_KEY_ENV_VARS)
      api_key = app_store_connect_api_key
    end

    sync_code_signing(
      type: 'developer_id',
      platform: 'macos',
      team_id: TEAM_ID,
      api_key: api_key,
      # Empty because we only care about the certificate at the moment, no need for provisioning profiles
      app_identifier: [],
      readonly: readonly,
      **CODE_SIGNING_STORAGE_OPTIONS
    )
  end

  desc 'Notarize the .app and .dmg artifacts produced by electron-builder.'
  lane :notarize_app do
    EnvManager.require_env_vars!(*ASC_API_KEY_ENV_VARS)

    api_key = app_store_connect_api_key

    Dir[File.join(PROJECT_ROOT_FOLDER, 'release', '**', '*.app')].each do |path|
      notarize(
        package: path,
        api_key: api_key,
        print_log: true
      )
    end

    Dir[File.join(PROJECT_ROOT_FOLDER, 'release', '**', '*.dmg')].each do |path|
      notarize(
        bundle_id: 'com.automattic.wordpress',
        package: path,
        api_key: api_key,
        print_log: true
      )
    end
  end

  desc <<~DESC
    Diagnose macOS code-signing chain trust on the CI VM.

    Dumps keychain search lists and Developer ID / Apple Root cert
    presence at each stage, runs `match` readonly to install the leaf
    cert, then attempts to codesign a tiny throwaway binary with the
    real Developer ID Application identity. The codesign call exercises
    the same trust-evaluation path that fails silently inside
    electron-builder.

    Drive the variants by setting KEYCHAIN_FIX before invocation:

        KEYCHAIN_FIX=none         bundle exec fastlane diagnose_signing_chain
        KEYCHAIN_FIX=search-list  bundle exec fastlane diagnose_signing_chain
        KEYCHAIN_FIX=cert-import  bundle exec fastlane diagnose_signing_chain
  DESC
  lane :diagnose_signing_chain do
    EnvManager.require_env_vars!(*CODE_SIGNING_ENV_VARS)

    banner = ->(label) { UI.message("\n========== #{label} ==========") }

    dump_state = lambda { |label|
      banner.call(label)
      sh('security', 'list-keychains', '-d', 'user', error_callback: ->(_e) {})
      sh('security', 'list-keychains', '-d', 'system', error_callback: ->(_e) {})
      sh('security', 'default-keychain', error_callback: ->(_e) {})

      keychains = [
        '/Library/Keychains/System.keychain',
        '/System/Library/Keychains/SystemRootCertificates.keychain',
        File.join(Dir.home, 'Library/Keychains/fastlane_tmp_keychain-db')
      ]
      keychains.each do |kc|
        UI.message("--- Developer ID / Apple Root certs in #{kc} ---")
        sh(
          'bash', '-c',
          "if [ -e '#{kc}' ]; then " \
            "security find-certificate -a -p '#{kc}' 2>/dev/null | " \
            "openssl crl2pkcs7 -nocrl -certfile /dev/stdin 2>/dev/null | " \
            "openssl pkcs7 -print_certs -noout 2>/dev/null | " \
            "grep -E 'Developer ID|Apple Root|Apple Worldwide' || echo '(no matching certs)'; " \
          "else echo '(keychain file does not exist)'; fi",
          error_callback: ->(_e) {}
        )
      end

      UI.message('--- security find-identity -v -p codesigning ---')
      sh('security', 'find-identity', '-v', '-p', 'codesigning', error_callback: ->(_e) {})
    }

    dump_state.call('1. POST-before_all (setup_ci + selected mitigation)')

    # Pass the real bundle id (matching Studio's setup) to falsify the
    # hypothesis that the empty `app_identifier` was making match fetch
    # a different cert payload than Studio's working build does.
    sync_code_signing(
      type: 'developer_id',
      platform: 'macos',
      team_id: TEAM_ID,
      app_identifier: ['com.automattic.wordpress'],
      readonly: true,
      **CODE_SIGNING_STORAGE_OPTIONS
    )

    dump_state.call('2. POST-match (leaf cert installed in temp keychain)')

    # Decisive AIA / egress / timing probes. Only run for the `none`
    # control, where the chain is broken (the mitigations already fix it).
    # The hypothesis is lazy AIA fetch: Security framework can fetch the
    # missing G2 intermediate from the leaf CA Issuers URL when it builds
    # the chain, but our codesign runs too soon. If that holds, the
    # network verify-cert below succeeds where the local-only one fails,
    # and the codesign at step 3 flips from FAIL to OK under this variant.
    if ENV.fetch('KEYCHAIN_FIX', 'cert-import') == 'none'
      banner.call('2a. AIA probes (KEYCHAIN_FIX=none control)')
      temp_kc = File.join(Dir.home, 'Library/Keychains/fastlane_tmp_keychain-db')
      login_kc = File.join(Dir.home, 'Library/Keychains/login.keychain-db')

      UI.message('--- Hypothesis 6: Developer ID / Apple Root certs in login.keychain-db ---')
      sh(
        'bash', '-c',
        "if [ -e '#{login_kc}' ]; then " \
          "security find-certificate -a -p '#{login_kc}' 2>/dev/null | " \
          "openssl crl2pkcs7 -nocrl -certfile /dev/stdin 2>/dev/null | " \
          "openssl pkcs7 -print_certs -noout 2>/dev/null | " \
          "grep -E 'Developer ID|Apple Root|Apple Worldwide' || echo '(no matching certs)'; " \
        "else echo '(login keychain does not exist)'; fi",
        error_callback: ->(_e) {}
      )

      UI.message('--- Egress probe: can the VM reach the leaf CA Issuers (AIA) URL? ---')
      sh(
        'bash', '-c',
        'curl -sS -o /tmp/devidg2.der ' \
        '-w "devidg2.der: HTTP %{http_code} time=%{time_total}s bytes=%{size_download}\n" ' \
        '--max-time 30 http://certs.apple.com/devidg2.der ' \
        '|| echo "curl FAILED (egress to certs.apple.com blocked?)"',
        error_callback: ->(_e) {}
      )

      leaf_pem = File.join(Dir.mktmpdir('leaf'), 'leaf.pem')
      sh(
        'bash', '-c',
        "security find-certificate -a -c 'Developer ID Application' -p '#{temp_kc}' > '#{leaf_pem}'",
        error_callback: ->(_e) {}
      )

      UI.message('--- verify-cert LOCAL ONLY (-L): expect FAIL, G2 is not present locally ---')
      sh('security', 'verify-cert', '-L', '-c', leaf_pem, '-p', 'codeSign',
         error_callback: ->(err) { UI.message("verify-cert (-L) FAIL: #{err}") })

      UI.message('--- verify-cert WITH NETWORK: if this PASSES, AIA fetched G2 (mechanism confirmed) ---')
      sh('security', 'verify-cert', '-c', leaf_pem, '-p', 'codeSign',
         error_callback: ->(err) { UI.message("verify-cert (network) FAIL: #{err}") })

      UI.message('--- find-identity immediately after verify-cert ---')
      sh('security', 'find-identity', '-v', '-p', 'codesigning', error_callback: ->(_e) {})

      UI.message('--- sleeping 120s to allow any lazy AIA fetch to complete ---')
      sleep(120)

      UI.message('--- find-identity after 120s sleep ---')
      sh('security', 'find-identity', '-v', '-p', 'codesigning', error_callback: ->(_e) {})
    end

    test_dir = Dir.mktmpdir('signing-chain-diagnose')
    test_bin = File.join(test_dir, 'hello')
    sh('bash', '-c', "printf 'int main(){return 0;}' | clang -o '#{test_bin}' -x c -")

    banner.call('3. codesign attempt with verbose chain output')
    codesign_result = nil
    sh(
      'codesign',
      '--sign', "Developer ID Application: Automattic, Inc. (#{TEAM_ID})",
      '--options', 'runtime',
      '--timestamp=none',
      '--verbose=4',
      test_bin,
      error_callback: ->(err) { codesign_result = "FAIL: #{err}" }
    )
    codesign_result ||= 'OK'

    banner.call('4. codesign --verify on the result')
    sh('codesign', '--verify', '--deep', '--strict', '--verbose=4', test_bin,
       error_callback: ->(_e) {})

    banner.call("RESULT for KEYCHAIN_FIX=#{ENV.fetch('KEYCHAIN_FIX', 'cert-import')}: codesign #{codesign_result}")
  end
end
