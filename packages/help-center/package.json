{
	"name": "@automattic/help-center",
	"version": "1.0.0",
	"description": "Help Center.",
	"homepage": "https://github.com/Automattic/wp-calypso",
	"license": "GPL-2.0-or-later",
	"author": "Automattic Inc.",
	"main": "dist/cjs/index.js",
	"module": "dist/esm/index.js",
	"calypso:src": "src/index.ts",
	"exports": {
		".": {
			"calypso:src": "./src/index.ts",
			"types": "./dist/types/index.d.ts",
			"import": "./dist/esm/index.js",
			"require": "./dist/cjs/index.js"
		},
		"./src/*": {
			"types": [
				"./src/*.ts",
				"./src/*.tsx",
				"./src/*/index.ts",
				"./src/*/index.tsx"
			],
			"calypso:src": "./src/*"
		}
	},
	"sideEffects": [
		"*.css",
		"*.scss"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Automattic/wp-calypso.git",
		"directory": "packages/help-center"
	},
	"publishConfig": {
		"access": "public"
	},
	"bugs": "https://github.com/Automattic/wp-calypso/issues",
	"types": "dist/types",
	"scripts": {
		"clean": "tsc --build ./tsconfig.json ./tsconfig-cjs.json --clean && rm -rf dist",
		"build": "tsc --build ./tsconfig.json ./tsconfig-cjs.json",
		"prepack": "yarn run clean && yarn run build",
		"watch": "tsc --build ./tsconfig.json --watch"
	},
	"dependencies": {
		"@automattic/agents-manager": "workspace:^",
		"@automattic/calypso-analytics": "workspace:^",
		"@automattic/calypso-config": "workspace:^",
		"@automattic/calypso-products": "workspace:^",
		"@automattic/components": "workspace:^",
		"@automattic/data-stores": "workspace:^",
		"@automattic/i18n-utils": "workspace:^",
		"@automattic/launchpad": "workspace:^",
		"@automattic/odie-client": "workspace:^",
		"@automattic/onboarding": "workspace:^",
		"@automattic/shopping-cart": "workspace:^",
		"@automattic/support-articles": "workspace:^",
		"@automattic/viewport": "workspace:^",
		"@automattic/viewport-react": "workspace:^",
		"@automattic/zendesk-client": "workspace:^",
		"@emotion/react": "^11.11.1",
		"@emotion/styled": "^11.11.0",
		"@tanstack/react-query": "^5.83.0",
		"@wordpress/a11y": "^5.2.0",
		"@wordpress/api-fetch": "^8.2.0",
		"@wordpress/base-styles": "^15.1.0",
		"@wordpress/components": "^45.0.0",
		"@wordpress/compose": "^9.2.0",
		"@wordpress/dataviews": "^22.1.0",
		"@wordpress/date": "^6.2.0",
		"@wordpress/html-entities": "^5.2.0",
		"@wordpress/i18n": "^7.2.0",
		"@wordpress/icons": "^21.0.0",
		"@wordpress/primitives": "^5.2.0",
		"@wordpress/react-i18n": "^5.2.0",
		"@wordpress/url": "^5.2.0",
		"clsx": "^2.1.1",
		"history": "^5.3.0",
		"prop-types": "^15.8.1",
		"react-draggable": "^4.4.6",
		"react-router-dom": "7.18.4",
		"smooch": "^5.7.20",
		"striptags": "^3.2.0",
		"use-debounce": "^10.0.6",
		"wpcom-proxy-request": "workspace:^"
	},
	"devDependencies": {
		"@automattic/calypso-color-schemes": "workspace:^",
		"@automattic/calypso-typescript-config": "workspace:^",
		"@storybook/react": "^10.6.5",
		"@testing-library/dom": "^10.4.2",
		"@testing-library/jest-dom": "^7.0.1",
		"@testing-library/react": "^16.3.3",
		"@testing-library/user-event": "^14.6.10",
		"@types/prop-types": "^15.7.15",
		"@types/smooch": "^5.6.0",
		"@wordpress/data": "^11.2.0",
		"postcss": "^8.5.32",
		"react": "^18.3.1",
		"react-dom": "^18.3.1",
		"storybook": "^10.6.5",
		"typescript": "^6.0.3",
		"vite": "^8.3.8",
		"vitest": "^5.1.0"
	},
	"peerDependencies": {
		"@automattic/calypso-router": "workspace:^",
		"@wordpress/data": "^11.2.0",
		"@wordpress/element": "^10.2.0",
		"react": "^18.3.1 || ^19.0.0",
		"react-dom": "^18.3.1 || ^19.0.0",
		"redux": "^5.0.1"
	},
	"private": true
}
