{
	"extends": "@automattic/calypso-typescript-config/ts-package.json",
	"compilerOptions": {
		"allowJs": true,
		"checkJs": false,
		"declarationDir": "dist/types",
		"outDir": "dist/esm",
		"rootDir": "src"
	},
	"include": [ "src", "src/*.json", "types" ],
	"exclude": [ "**/test/*", "**/*.test.ts", "**/*.test.tsx", "**/*.test.js", "**/__mocks__/**" ],
	"references": [
		{ "path": "../agents-manager" },
		{ "path": "../agenttic-client" },
		{ "path": "../agenttic-ui" },
		{ "path": "../calypso-analytics" }
	]
}
