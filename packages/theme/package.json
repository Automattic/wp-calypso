{
	"name": "@automattic/theme",
	"version": "0.0.1",
	"description": "A package to theme UIs at Automattic.",
	"homepage": "https://github.com/Automattic/wp-calypso/tree/HEAD/packages/theme#readme",
	"license": "GPL-2.0-or-later",
	"author": "Automattic Inc.",
	"main": "dist/cjs/index.js",
	"module": "dist/esm/index.js",
	"calypso:src": "src/index.ts",
	"sideEffects": [
		"*.css",
		"*.scss"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Automattic/wp-calypso.git",
		"directory": "packages/theme"
	},
	"publishConfig": {
		"access": "public"
	},
	"bugs": "https://github.com/Automattic/wp-calypso/issues",
	"scripts": {
		"clean": "tsc --build ./tsconfig.json ./tsconfig-cjs.json --clean && rm -rf dist",
		"build": "tsc --build ./tsconfig.json ./tsconfig-cjs.json && copy-assets && copyfiles package.json dist/",
		"prepack": "yarn run clean && yarn run build",
		"storybook:start": "storybook dev -p 57862"
	},
	"files": [
		"dist",
		"src"
	],
	"types": "dist/types/index.d.ts",
	"keywords": [
		"admin",
		"ui",
		"components",
		"framework",
		"wp-admin"
	],
	"dependencies": {
		"@wordpress/components": "^29.7.0",
		"bezier-easing": "^2.1.0",
		"colorjs.io": "^0.5.2"
	},
	"peerDependencies": {
		"react": "^18.3.1",
		"react-dom": "^18.3.1"
	},
	"devDependencies": {
		"@automattic/calypso-build": "workspace:^",
		"@automattic/calypso-storybook": "workspace:^",
		"@automattic/calypso-typescript-config": "workspace:^",
		"copyfiles": "^2.4.1",
		"postcss": "^8.4.5",
		"storybook": "^8.6.9",
		"typescript": "^5.3.3",
		"webpack": "^5.97.1"
	}
}
