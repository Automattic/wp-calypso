{
	"name": "@automattic/agenttic-client",
	"version": "0.2.1",
	"type": "module",
	"description": "A TypeScript client library for connection to the Automattic agent framework.",
	"main": "dist/index.js",
	"module": "dist/index.js",
	"types": "dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./mocks": {
			"types": "./dist/mocks/index.d.ts",
			"import": "./dist/mocks/index.js"
		},
		"./agents-api": {
			"types": "./dist/agents-api/index.d.ts",
			"import": "./dist/agents-api/index.js"
		}
	},
	"files": [
		"dist",
		"!dist/tsconfig.tsbuildinfo"
	],
	"scripts": {
		"build": "yarn run build:js && tsc --project tsconfig.json --emitDeclarationOnly",
		"build:js": "yarn run clean && vite build",
		"prepare": "yarn run build",
		"dev": "vite build --watch",
		"clean": "rm -rf dist",
		"type-check": "tsc --noEmit",
		"lint": "eslint src",
		"lint:fix": "eslint src --fix",
		"test": "vitest run",
		"prepublishOnly": "yarn run build"
	},
	"keywords": [
		"agent2agent",
		"agenttic",
		"client",
		"typescript",
		"ai",
		"agent",
		"protocol"
	],
	"author": "Automattic Inc.",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Automattic/wp-calypso.git",
		"directory": "packages/agenttic-client"
	},
	"homepage": "https://github.com/Automattic/wp-calypso",
	"bugs": "https://github.com/Automattic/wp-calypso/issues",
	"engines": {
		"node": "^22.12.0 || ^24.0.0 || >=26.0.0"
	},
	"devDependencies": {
		"@automattic/calypso-eslint-config": "workspace:^",
		"@types/react-dom": "^18.0.0 || ^19.0.0",
		"@wordpress/api-fetch": "^8.1.0",
		"autoprefixer": "^10.4.0",
		"postcss": "^8.5.32",
		"react": "^18.0.0",
		"react-dom": "^18.0.0",
		"typescript": "^5.9.3",
		"unified": "^11.0.5",
		"vite": "^8.3.7",
		"vite-plugin-lib-inject-css": "^2.2.2",
		"vitest": "^5.1.0"
	},
	"dependencies": {
		"@types/react": "^18.0.0 || ^19.0.0"
	},
	"optionalDependencies": {
		"marked": "^16.4.2"
	},
	"peerDependencies": {
		"@wordpress/api-fetch": "^6.0.0 || ^7.0.0 || ^8.0.0",
		"react": "^18.0.0 || ^19.0.0"
	},
	"peerDependenciesMeta": {
		"@wordpress/api-fetch": {
			"optional": true
		}
	},
	"publishConfig": {
		"access": "public"
	}
}
