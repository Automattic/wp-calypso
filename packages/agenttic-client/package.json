{
	"name": "@automattic/agenttic-client",
	"version": "1.0.0",
	"type": "module",
	"description": "A TypeScript client library for A2A (Agent2Agent) protocol communication",
	"main": "dist/index.js",
	"module": "dist/index.js",
	"types": "dist/index.d.ts",
	"bin": {
		"agenttic-test": "./dist/cli/index.js"
	},
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./browser": {
			"types": "./dist/browser.d.ts",
			"import": "./dist/browser.js"
		},
		"./node": {
			"types": "./dist/node.d.ts",
			"import": "./dist/node.js"
		},
		"./cli": {
			"types": "./dist/cli/index.d.ts",
			"import": "./dist/cli/index.js"
		}
	},
	"files": [
		"dist",
		"README.md"
	],
	"scripts": {
		"build": "pnpm run clean && tsup src/index.ts src/browser.ts src/node.ts src/cli/index.ts --format esm --target node18 && tsc --emitDeclarationOnly",
		"build:cli": "tsup src/cli/index.ts --format esm --target node18",
		"dev": "tsup src/index.ts src/browser.ts src/node.ts src/cli/index.ts --format esm --watch",
		"clean": "rm -rf dist",
		"type-check": "tsc --noEmit",
		"lint": "wp-scripts lint-js src --ext .ts,.tsx",
		"lint:fix": "wp-scripts lint-js src --ext .ts,.tsx --fix",
		"test": "vitest",
		"cli": "node dist/cli/index.js",
		"test:cli": "node dist/cli/index.js --help",
		"prepublishOnly": "pnpm run build"
	},
	"keywords": [
		"a2a",
		"agent2agent",
		"agenttic",
		"client",
		"typescript",
		"ai",
		"agent",
		"protocol"
	],
	"author": "Automattic",
	"license": "MIT",
	"engines": {
		"node": ">=18.0.0"
	},
	"devDependencies": {
		"@types/debug": "^4.1.12",
		"@types/node": "^20.0.0",
		"tsup": "^8.0.0",
		"typescript": "^5.0.0",
		"vitest": "^1.0.0"
	},
	"dependencies": {
		"@types/react": "^18.0.0",
		"@types/uuid": "^10.0.0",
		"@wordpress/element": "^6.2.0",
		"chalk": "^5.4.1",
		"debug": "^4.3.4",
		"dotenv": "^16.5.0",
		"fetch-socks": "^1.3.2",
		"react": "^18.0.0",
		"uuid": "^11.1.0"
	},
	"peerDependencies": {
		"react": "^18.0.0"
	},
	"publishConfig": {
		"access": "public"
	}
}
