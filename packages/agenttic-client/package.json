{
	"name": "@automattic/agenttic-client",
	"version": "0.1.13",
	"type": "module",
	"description": "A TypeScript client library for A2A (Agent2Agent) protocol communication",
	"main": "dist/index.js",
	"module": "dist/index.js",
	"types": "dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./mocks": {
			"types": "./dist/mocks/index.d.ts",
			"import": "./dist/mocks/index.js"
		}
	},
	"files": [
		"dist",
		"README.md"
	],
	"scripts": {
		"build": "pnpm run clean && vite build && tsc --project tsconfig.json --emitDeclarationOnly",
		"dev": "vite build --watch",
		"clean": "rm -rf dist",
		"type-check": "tsc --noEmit",
		"lint": "wp-scripts lint-js src --ext .ts,.tsx",
		"lint:fix": "wp-scripts lint-js src --ext .ts,.tsx --fix",
		"test": "vitest run",
		"prepublishOnly": "pnpm run build",
		"i18n:extract": "npx --no-install @wordpress/i18n-command make-pot src --output=languages/a8c-agenttic.pot --domain=a8c-agenttic",
		"i18n:update": "npx --no-install @wordpress/i18n-command make-json languages --domain=a8c-agenttic"
	},
	"keywords": [
		"a2a",
		"agent2agent",
		"agenttic",
		"client",
		"typescript",
		"ai",
		"agent",
		"protocol"
	],
	"author": "Automattic",
	"license": "MIT",
	"engines": {
		"node": ">=20.0.0"
	},
	"devDependencies": {
		"@wordpress/api-fetch": "^7.0.0",
		"autoprefixer": "^10.4.0",
		"typescript": "^5.0.0",
		"unified": "^11.0.5",
		"vite": "^5.0.0",
		"vite-plugin-lib-inject-css": "^2.2.2",
		"vitest": "^1.0.0"
	},
	"dependencies": {
		"@automattic/charts": ">=0.14.0 <1.0.0",
		"@types/react": "^18.0.0",
		"@visx/xychart": "^3.12.0",
		"@wordpress/i18n": "^6.1.0",
		"react": "^18.0.0",
		"react-markdown": "^10.1.0",
		"remark-gfm": "^4.0.1",
		"streamdown": "1.1.1"
	},
	"peerDependencies": {
		"@wordpress/api-fetch": "^6.0.0 || ^7.0.0",
		"react": "^18.0.0"
	},
	"peerDependenciesMeta": {
		"@wordpress/api-fetch": {
			"optional": true
		}
	},
	"publishConfig": {
		"access": "public",
		"branch": "trunk"
	}
}
