{
	"name": "@automattic/agenttic-client",
	"version": "1.0.0",
	"type": "module",
	"description": "A TypeScript client library for A2A (Agent2Agent) protocol communication",
	"main": "dist/index.js",
	"module": "dist/index.js",
	"types": "dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		}
	},
	"files": [
		"dist",
		"README.md"
	],
	"scripts": {
		"build": "pnpm run clean && tsup src/index.ts --format esm --target node18 && tsc --emitDeclarationOnly",
		"dev": "tsup src/index.ts --format esm --watch",
		"clean": "rm -rf dist",
		"type-check": "tsc --noEmit",
		"lint": "wp-scripts lint-js src --ext .ts,.tsx",
		"lint:fix": "wp-scripts lint-js src --ext .ts,.tsx --fix",
		"test": "vitest run",
		"prepublishOnly": "pnpm run build"
	},
	"keywords": [
		"a2a",
		"agent2agent",
		"agenttic",
		"client",
		"typescript",
		"ai",
		"agent",
		"protocol"
	],
	"author": "Automattic",
	"license": "MIT",
	"engines": {
		"node": ">=18.0.0"
	},
	"devDependencies": {
		"tsup": "^8.0.0",
		"typescript": "^5.0.0",
		"vitest": "^1.0.0"
	},
	"dependencies": {
		"@automattic/charts": "^0.14.0",
		"@types/react": "^18.0.0",
		"@visx/xychart": "^3.12.0",
		"@wordpress/element": "^6.2.0",
		"react": "^18.0.0",
		"react-markdown": "^10.1.0"
	},
	"peerDependencies": {
		"react": "^18.0.0"
	},
	"publishConfig": {
		"access": "public"
	}
}
