{
	"name": "@automattic/agenttic-client",
	"version": "0.1.70",
	"type": "module",
	"description": "A TypeScript client library for connection to the Automattic agent framework.",
	"main": "dist/index.js",
	"module": "dist/index.js",
	"types": "dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./mocks": {
			"types": "./dist/mocks/index.d.ts",
			"import": "./dist/mocks/index.js"
		},
		"./agents-api": {
			"types": "./dist/agents-api/index.d.ts",
			"import": "./dist/agents-api/index.js"
		}
	},
	"files": [
		"dist",
		"README.md"
	],
	"scripts": {
		"build": "pnpm run clean && vite build && tsc --project tsconfig.json --emitDeclarationOnly",
		"dev": "vite build --watch",
		"clean": "rm -rf dist",
		"type-check": "tsc --noEmit",
		"lint": "wp-scripts lint-js src --ext .ts,.tsx",
		"lint:fix": "wp-scripts lint-js src --ext .ts,.tsx --fix",
		"test": "vitest run",
		"prepublishOnly": "pnpm run build"
	},
	"keywords": [
		"agent2agent",
		"agenttic",
		"client",
		"typescript",
		"ai",
		"agent",
		"protocol"
	],
	"author": "Automattic",
	"license": "MIT",
	"engines": {
		"node": ">=20.0.0"
	},
	"devDependencies": {
		"@wordpress/api-fetch": "^7.0.0",
		"autoprefixer": "^10.4.0",
		"typescript": "^5.0.0",
		"unified": "^11.0.5",
		"vite": "^5.0.0",
		"vite-plugin-lib-inject-css": "^2.2.2",
		"vitest": "^1.0.0"
	},
	"dependencies": {
		"@types/react": "^18.0.0",
		"react": "^18.0.0"
	},
	"optionalDependencies": {
		"marked": "^16.2.1"
	},
	"peerDependencies": {
		"@wordpress/api-fetch": "^6.0.0 || ^7.0.0",
		"react": "^18.0.0"
	},
	"peerDependenciesMeta": {
		"@wordpress/api-fetch": {
			"optional": true
		}
	},
	"publishConfig": {
		"access": "public",
		"branch": "trunk"
	}
}
