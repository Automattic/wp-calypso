{
	"name": "@automattic/site-admin",
	"version": "0.0.1-beta.2",
	"description": "A modern UI framework for building WordPress administrative interfaces.",
	"main": "dist/cjs/index.js",
	"module": "dist/esm/index.js",
	"types": "dist/types/index.d.ts",
	"calypso:src": "src/index.ts",
	"sideEffects": false,
	"scripts": {
		"clean": "tsc --build ./tsconfig.json ./tsconfig-cjs.json --clean && rm -rf dist",
		"build": "tsc --build ./tsconfig.json ./tsconfig-cjs.json && copy-assets",
		"prepack": "yarn run clean && yarn run build",
		"watch": "tsc --build ./tsconfig.json --watch"
	},
	"files": [
		"dist",
		"src"
	],
	"keywords": [
		"admin",
		"ui",
		"components",
		"framework",
		"dashboard",
		"react",
		"wp-admin"
	],
	"publishConfig": {
		"access": "public"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Automattic/wp-calypso.git",
		"directory": "packages/site-admin"
	},
	"author": "Automattic Inc.",
	"license": "GPL-2.0-or-later",
	"bugs": "https://github.com/Automattic/wp-calypso/issues",
	"homepage": "https://github.com/Automattic/wp-calypso/tree/HEAD/packages/site-admin#readme",
	"peerDependencies": {
		"@wordpress/data": "^10.16.0",
		"react": "^18.3.1",
		"react-dom": "^18.3.1"
	},
	"dependencies": {
		"@wordpress/base-styles": "^5.17.0",
		"@wordpress/commands": "^1.17.0",
		"@wordpress/components": "^29.3.0",
		"@wordpress/dom": "^4.17.0",
		"@wordpress/edit-site": "^6.17.0",
		"@wordpress/element": "^6.17.0",
		"@wordpress/i18n": "^5.17.0",
		"@wordpress/icons": "^10.17.0",
		"@wordpress/url": "^4.17.0",
		"clsx": "^2.1.1",
		"photon": "workspace:^"
	},
	"devDependencies": {
		"@automattic/calypso-build": "workspace:^",
		"@automattic/calypso-typescript-config": "workspace:^",
		"postcss": "^8.4.5",
		"typescript": "^5.3.3",
		"webpack": "^5.97.1"
	}
}
