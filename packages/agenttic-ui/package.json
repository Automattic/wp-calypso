{
	"name": "@automattic/agenttic-ui",
	"version": "0.1.65",
	"type": "module",
	"description": "UI components for the Agenttic framework",
	"main": "dist/index.js",
	"module": "dist/index.js",
	"types": "dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./embedded-agent-ui": {
			"types": "./dist/embedded-agent-ui.d.ts",
			"import": "./dist/embedded-agent-ui.js"
		},
		"./index.css": "./dist/index.css"
	},
	"files": [
		"dist",
		"README.md"
	],
	"scripts": {
		"build": "pnpm run clean && pnpm i18n:download-json && vite build && tsc --project tsconfig.json --emitDeclarationOnly",
		"dev": "vite",
		"clean": "rm -rf dist",
		"type-check": "tsc --noEmit",
		"lint": "wp-scripts lint-js src --ext .ts,.tsx",
		"lint:fix": "wp-scripts lint-js src --ext .ts,.tsx --fix",
		"test": "vitest run",
		"prepublishOnly": "pnpm run build",
		"storybook": "storybook dev -p 6006",
		"build-storybook": "storybook build -o storybook-static",
		"i18n:download-json": "../../scripts/download-translation-files.js"
	},
	"keywords": [
		"agenttic",
		"ui",
		"components",
		"react",
		"typescript",
		"ai",
		"agent"
	],
	"author": "Automattic",
	"license": "MIT",
	"engines": {
		"node": ">=20.0.0"
	},
	"devDependencies": {
		"@mdx-js/react": "^3.1.0",
		"@storybook/addon-a11y": "^9.0.18",
		"@storybook/addon-docs": "^9.0.18",
		"@storybook/addon-essentials": "9.0.0-alpha.12",
		"@storybook/addon-links": "^9.0.18",
		"@storybook/addon-onboarding": "^9.0.18",
		"@storybook/blocks": "9.0.0-alpha.17",
		"@storybook/manager-api": "^8.6.14",
		"@storybook/react": "^9.0.18",
		"@storybook/react-vite": "^9.0.18",
		"@storybook/test": "9.0.0-alpha.2",
		"@types/node": "^20.0.0",
		"@types/react": "^18.0.0",
		"@types/react-dom": "^18.0.0",
		"@wordpress/prettier-config": "^4.2.0",
		"@wordpress/scripts": "^27.9.0",
		"autoprefixer": "^10.4.0",
		"eslint-import-resolver-typescript": "^4.4.4",
		"jsdom": "^24.0.0",
		"postcss": "^8.4.0",
		"storybook": "^9.0.18",
		"typescript": "^5.0.0",
		"vite": "^5.0.0",
		"vite-plugin-lib-inject-css": "^2.2.2",
		"vitest": "^1.0.0"
	},
	"dependencies": {
		"@automattic/charts": ">=0.58.0 <1.0.0",
		"@radix-ui/react-popover": "^1.1.15",
		"@radix-ui/react-scroll-area": "^1.2.9",
		"@radix-ui/react-slot": "^1.2.3",
		"@visx/xychart": "^3.12.0",
		"@wordpress/i18n": "^6.1.0",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"framer-motion": "^12.23.0",
		"lucide-react": "^0.525.0",
		"react": "^18.0.0",
		"react-dom": "^18.0.0",
		"react-markdown": "^10.1.0",
		"react-textarea-autosize": "^8.5.9",
		"remark-gfm": "^4.0.1",
		"unified": "^11.0.5",
		"use-debounce": "^10.0.6"
	},
	"optionalDependencies": {
		"marked": "^16.2.1"
	},
	"peerDependencies": {
		"react": "^18.0.0",
		"react-dom": "^18.0.0"
	},
	"publishConfig": {
		"access": "public",
		"branch": "trunk"
	},
	"overrides": {
		"esbuild": "0.24.0"
	}
}
