{
	"name": "@automattic/dataviews",
	"version": "0.1.0",
	"private": true,
	"description": "DataViews is a component that provides an API to render datasets using different types of layouts (table, grid, list, etc.).",
	"author": "Automattic Inc.",
	"license": "GPL-2.0-or-later",
	"homepage": "https://github.com/automattic/wp-calypso/tree/HEAD/packages/dataviews/README.md",
	"repository": {
		"type": "git",
		"url": "https://github.com/automattic/wp-calypso.git",
		"directory": "packages/dataviews"
	},
	"bugs": {
		"url": "https://github.com/automattic/wp-calypso/issues"
	},
	"engines": {
		"node": ">=18.12.0",
		"npm": ">=8.19.2"
	},
	"main": "build/index.js",
	"module": "build-module/index.js",
	"calypso:src": "src/index.ts",
	"exports": {
		".": {
			"types": "./build-types/index.d.ts",
			"import": "./build-module/index.js",
			"default": "./build/index.js"
		},
		"./wp": {
			"types": "./build-types/index.d.ts",
			"default": "./build-wp/index.js"
		},
		"./package.json": {
			"default": "./package.json"
		},
		"./build-style/": "./build-style/"
	},
	"react-native": "src/index",
	"wpScript": true,
	"types": "build-types",
	"sideEffects": false,
	"dependencies": {
		"@ariakit/react": "^0.4.15",
		"@babel/runtime": "7.26.10",
		"@emotion/babel-plugin": "^11.13.5",
		"@wordpress/babel-preset-default": "^8.22.0",
		"@wordpress/base-styles": "^5.22.0",
		"@wordpress/components": "^29.8.0",
		"@wordpress/compose": "^7.22.0",
		"@wordpress/data": "^10.22.0",
		"@wordpress/element": "^6.22.0",
		"@wordpress/i18n": "^5.22.0",
		"@wordpress/icons": "^10.22.0",
		"@wordpress/primitives": "^4.22.0",
		"@wordpress/private-apis": "^1.22.0",
		"@wordpress/warning": "^3.22.0",
		"babel-plugin-inline-json-import": "^0.3.2",
		"clsx": "^2.1.1",
		"glob": "^11.0.1",
		"remove-accents": "^0.5.0"
	},
	"peerDependencies": {
		"react": "^18.0.0",
		"react-dom": "^18.0.0"
	},
	"publishConfig": {
		"access": "public"
	},
	"devDependencies": {
		"@wordpress/postcss-plugins-preset": "^5.22.0",
		"postcss": "^8.5.3",
		"postcss-local-keyframes": "^0.0.2",
		"sass": "^1.54.0"
	},
	"scripts": {
		"build:js": "node build-js.js",
		"build:style": "node build-style.js",
		"build:wp": "node build",
		"clean": "git clean --force -d -X"
	}
}
