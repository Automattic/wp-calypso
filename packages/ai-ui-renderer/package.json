{
	"name": "@automattic/ai-ui-renderer",
	"version": "1.0.0",
	"private": true,
	"description": "Render AI-generated A2UI messages with WordPress components.",
	"homepage": "https://github.com/Automattic/wp-calypso",
	"license": "GPL-2.0-or-later",
	"author": "Automattic Inc.",
	"main": "dist/cjs/index.js",
	"module": "dist/esm/index.js",
	"calypso:src": "src/index.ts",
	"exports": {
		".": {
			"calypso:src": "./src/index.ts",
			"types": "./dist/types/index.d.ts",
			"import": "./dist/esm/index.js",
			"require": "./dist/cjs/index.js"
		},
		"./capabilities": {
			"calypso:src": "./src/capabilities.ts",
			"types": "./dist/types/capabilities.d.ts",
			"import": "./dist/esm/capabilities.js",
			"require": "./dist/cjs/capabilities.js"
		},
		"./style.scss": {
			"calypso:src": "./src/style.scss",
			"default": "./dist/esm/style.scss"
		}
	},
	"sideEffects": [
		"*.scss"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Automattic/wp-calypso.git",
		"directory": "packages/ai-ui-renderer"
	},
	"bugs": "https://github.com/Automattic/wp-calypso/issues",
	"files": [
		"dist",
		"src"
	],
	"types": "dist/types",
	"scripts": {
		"clean": "tsc --build ./tsconfig.json ./tsconfig-cjs.json --clean && rm -rf dist",
		"build": "tsc --build ./tsconfig.json ./tsconfig-cjs.json && yarn run -T copy-assets",
		"prepack": "yarn run clean && yarn run build",
		"watch": "tsc --build ./tsconfig.json --watch"
	},
	"dependencies": {
		"@a2ui/markdown-it": "0.2.2",
		"@a2ui/react": "0.14.0",
		"@a2ui/web_core": "0.14.0",
		"@automattic/charts": "^1.10.0",
		"@automattic/number-formatters": "^1.2.10",
		"@wordpress/base-styles": "^9.1.0",
		"@wordpress/i18n": "^6.21.0",
		"@wordpress/icons": "^13.3.0",
		"@wordpress/ui": "^0.23.0",
		"clsx": "^2.1.1",
		"tslib": "^2.8.1",
		"zod": "^3.25.76"
	},
	"devDependencies": {
		"@automattic/calypso-typescript-config": "workspace:^",
		"@testing-library/dom": "^10.4.2",
		"@testing-library/react": "^16.3.3",
		"@types/react": "^18.3.1",
		"typescript": "^6.0.3"
	},
	"peerDependencies": {
		"@wordpress/element": "^8.0.0",
		"react": "^18.3.1 || ^19.0.0",
		"react-dom": "^18.3.1 || ^19.0.0"
	}
}
