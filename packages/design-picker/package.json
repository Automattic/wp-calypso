{
	"name": "@automattic/design-picker",
	"version": "1.0.0",
	"description": "Design picker.",
	"homepage": "https://github.com/Automattic/wp-calypso",
	"license": "GPL-2.0-or-later",
	"author": "Automattic Inc.",
	"main": "dist/cjs/index.js",
	"module": "dist/esm/index.js",
	"calypso:src": "src/index.ts",
	"exports": {
		".": {
			"calypso:src": "./src/index.ts",
			"types": "./dist/types/index.d.ts",
			"import": "./dist/esm/index.js",
			"require": "./dist/cjs/index.js"
		}
	},
	"sideEffects": [
		"*.css",
		"*.scss"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Automattic/wp-calypso.git",
		"directory": "packages/design-picker"
	},
	"publishConfig": {
		"access": "public"
	},
	"bugs": "https://github.com/Automattic/wp-calypso/issues",
	"types": "dist/types",
	"scripts": {
		"clean": "tsc --build ./tsconfig.json ./tsconfig-cjs.json --clean && rm -rf dist",
		"build": "tsc --build ./tsconfig.json ./tsconfig-cjs.json && copy-assets",
		"prepack": "yarn run clean && yarn run build",
		"watch": "tsc --build ./tsconfig.json --watch"
	},
	"dependencies": {
		"@automattic/calypso-analytics": "workspace:^",
		"@automattic/calypso-config": "workspace:^",
		"@automattic/components": "workspace:^",
		"@automattic/design-types": "workspace:^",
		"@automattic/global-styles": "workspace:^",
		"@automattic/js-utils": "workspace:^",
		"@automattic/onboarding": "workspace:^",
		"@automattic/typography": "workspace:^",
		"@automattic/viewport": "workspace:^",
		"@tanstack/react-query": "^5.83.0",
		"@wordpress/components": "^45.0.0",
		"@wordpress/compose": "^9.2.0",
		"@wordpress/react-i18n": "^5.2.0",
		"@wordpress/url": "^5.2.0",
		"clsx": "^2.1.1",
		"i18n-calypso": "workspace:^",
		"photon": "workspace:^",
		"react-intersection-observer": "^9.4.3",
		"react-router-dom": "7.18.4",
		"tslib": "^2.8.1",
		"utility-types": "^3.10.0"
	},
	"devDependencies": {
		"@automattic/calypso-build": "workspace:^",
		"@automattic/calypso-eslint-config": "workspace:^",
		"@automattic/calypso-typescript-config": "workspace:^",
		"@storybook/react": "^10.6.8",
		"@testing-library/dom": "^10.4.2",
		"@testing-library/jest-dom": "^7.0.1",
		"@testing-library/react": "^16.3.3",
		"@wordpress/data": "^11.2.0",
		"@wordpress/element": "^10.2.0",
		"@wordpress/i18n": "^7.2.0",
		"debug": "^4.4.3",
		"jsdom": "^20.0.3",
		"postcss": "^8.5.32",
		"react": "^18.3.1",
		"react-dom": "^18.3.1",
		"redux": "^5.0.1",
		"storybook": "^10.6.8",
		"typescript": "^6.0.3",
		"vite": "^8.3.8",
		"vitest": "^5.1.0",
		"webpack": "^5.111.1"
	},
	"peerDependencies": {
		"@wordpress/data": "^11.2.0",
		"@wordpress/element": "^10.2.0",
		"@wordpress/i18n": "^7.2.0",
		"debug": "^4.4.3",
		"react": "^18.3.1 || ^19.0.0",
		"react-dom": "^18.3.1 || ^19.0.0",
		"redux": "^5.0.1"
	},
	"private": true
}
