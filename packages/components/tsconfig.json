{
	"extends": "@automattic/calypso-typescript-config/ts-package.json",
	"compilerOptions": {
		"allowJs": true,
		"checkJs": false,
		"outDir": "dist/esm",
		"declarationDir": "dist/types",
		"rootDir": "src",
		// Private `Menu` API types, which `@wordpress/components` doesn't export.
		"paths": {
			"@wordpress/components/src/menu/types": [
				"../../node_modules/@wordpress/components/build-types/menu/types.d.ts"
			]
		}
	},
	"include": [ "src" ],
	"exclude": [ "**/docs/*", "**/test/*" ],
	"references": [
		{ "path": "../calypso-analytics" },
		{ "path": "../calypso-url" },
		{ "path": "../i18n-utils" },
		{ "path": "../js-utils" }
	]
}
