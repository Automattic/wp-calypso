{
	"name": "@automattic/agent-components",
	"version": "0.1.0",
	"private": true,
	"description": "Portable button action components for agent hosts.",
	"license": "GPL-2.0-or-later",
	"main": "dist/cjs/index.js",
	"module": "dist/esm/index.js",
	"types": "dist/types/index.d.ts",
	"typesVersions": {
		"*": {
			"validation": [
				"dist/types/validation.d.ts"
			]
		}
	},
	"calypso:src": "src/index.ts",
	"exports": {
		".": {
			"calypso:src": "./src/index.ts",
			"types": "./dist/types/index.d.ts",
			"import": "./dist/esm/index.js",
			"require": "./dist/cjs/index.js"
		},
		"./validation": {
			"calypso:src": "./src/validation.ts",
			"types": "./dist/types/validation.d.ts",
			"import": "./dist/esm/validation.js",
			"require": "./dist/cjs/validation.js"
		},
		"./style.css": "./src/style.css"
	},
	"sideEffects": [
		"*.css"
	],
	"scripts": {
		"build": "tsc --build ./tsconfig.json ./tsconfig-cjs.json",
		"test": "cd ../.. && yarn jest -c packages/agent-components/jest.config.js",
		"lint": "run -T eslint src/"
	},
	"devDependencies": {
		"@automattic/calypso-typescript-config": "workspace:^",
		"@testing-library/react": "^15.0.7",
		"@types/react": "^18.3.1",
		"react": "^18.3.1",
		"react-dom": "^18.3.1",
		"typescript": "^6.0.3"
	},
	"dependencies": {
		"@wordpress/element": "^8.0.0",
		"tslib": "^2.8.1"
	},
	"peerDependencies": {
		"react": "^18.3.1 || ^19.0.0"
	}
}
