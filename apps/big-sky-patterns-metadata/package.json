{
	"name": "a8c-big-sky-patterns-metadata-sidebar",
	"description": "A8c Big Sky Patterns Metadata Sidebar - WordPress plugin for pattern metadata configuration",
	"version": "1.0.0",
	"license": "GPL-2.0-or-later",
	"main": "build/index.js",
	"scripts": {
		"build": "wp-scripts build --webpack-copy-php",
		"build:dev": "wp-scripts start --no-watch --webpack-copy-php",
		"start": "wp-scripts start",
		"format": "wp-scripts format",
		"lint:css": "wp-scripts lint-style",
		"lint:js": "wp-scripts lint-js",
		"lint:js:fix": "wp-scripts lint-js --fix",
		"packages-update": "wp-scripts packages-update",
		"plugin-zip": "wp-scripts plugin-zip",
		"dev": "yarn run calypso-apps-builder --localPath ./build --remotePath /home/wpcom/public_html/wp-content/a8c-plugins/pattern-metadata-sidebar",
		"clean": "rm -rf build/"
	},
	"dependencies": {
		"@wordpress/components": "^29.9.0",
		"@wordpress/core-data": "7.23.0",
		"@wordpress/data": "^10.23.0",
		"@wordpress/edit-post": "8.23.0",
		"@wordpress/editor": "14.23.0",
		"@wordpress/element": "^6.23.0",
		"@wordpress/i18n": "^5.23.0",
		"@wordpress/icons": "^10.23.0",
		"@wordpress/plugins": "7.23.0"
	},
	"devDependencies": {
		"@automattic/calypso-apps-builder": "workspace:^",
		"@wordpress/prettier-config": "^4.23.0",
		"@wordpress/scripts": "^27.9.0"
	}
}
